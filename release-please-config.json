{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "course-kit",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "js/package.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "python/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "generic", "path": "python/src/nma_kit/__init__.py" },
        { "type": "generic", "path": ".github/workflows/course-check.yml" },
        { "type": "generic", "path": ".github/workflows/course-publish.yml" }
      ]
    }
  }
}
