        "solution1": "https://github.com/o/r/blob/notebooks-branch/notebooks/projects/solutions/P1_Solution_1.py"
      }
    },
    {
      "name": "deepest content root wins",
      "myst": "version: 1\nproject:\n  github: https://github.com/o/r\nnma:\n  paths:\n    tutorials: course\n    projects: course/projects\n",
      "page": "course/projects/P1.md",
      "expect": {
        "root": "projects",
        "relDir": "",
        "notebookDir": "projects",
        "stem": "P1",
        "notebook": "notebooks/projects/P1.ipynb",
        "colab": "https://colab.research.google.com/github/o/r/blob/notebooks-branch/notebooks/projects/P1.ipynb",
