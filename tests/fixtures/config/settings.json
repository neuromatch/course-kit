        "colab": "https://colab.research.google.com/github/o/r/blob/notebooks-branch/notebooks/projects/Neuroscience/ProjectA.ipynb",
        "kaggle": "https://kaggle.com/kernels/welcome?src=https://raw.githubusercontent.com/o/r/notebooks-branch/notebooks/projects/Neuroscience/ProjectA.ipynb",
        "solution1": "https://github.com/o/r/blob/notebooks-branch/notebooks/projects/Neuroscience/solutions/ProjectA_Solution_1.py"
      }
    },
    {
      "name": "custom projects dir keeps the projects root name",
      "myst": "version: 1\nproject:\n  github: https://github.com/o/r\nnma:\n  paths:\n    projects: capstone\n",
      "page": "capstone/P1.md",
